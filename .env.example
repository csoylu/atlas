# Copy to .env (gitignored). The engine loads it at start. Never commit real keys.
# Anthropic API key, used by the 'sonnet' model.
ANTHROPIC_API_KEY=
# Key of the local OpenAI-compatible server used by the 'local' model (llama.cpp --api-key), if it has one.
ATLAS_LOCAL_API_KEY=
# Claude plan (design §5): ONLY the details Anthropic issued to Atlas with its approval. Desktop: fill them on the
# Models page instead (keychain). Claude Code's client id is refused.
# ATLAS_CLAUDE_CLIENT_ID=
# ATLAS_CLAUDE_CLIENT_SECRET=
# ATLAS_CLAUDE_AUTHORIZE_URL=
# ATLAS_CLAUDE_TOKEN_URL=
# ATLAS_CLAUDE_REVOKE_URL=
# ATLAS_CLAUDE_SCOPES=
# ATLAS_CLAUDE_REDIRECT_PORT=
# ATLAS_CLAUDE_API_BASE=https://api.anthropic.com
# ATLAS_CLAUDE_HEADERS={}
# ATLAS_PORT=4317
# ATLAS_DATA_DIR=./data
# Server mode (VPS): the login password, 12+ characters (e.g. `openssl rand -base64 24`). Unset = no login, and the
# engine only answers on localhost. Keep the engine on 127.0.0.1 and put Caddy (HTTPS) or Tailscale in front of it.
# ATLAS_PASSWORD=
# ATLAS_HOST=127.0.0.1
