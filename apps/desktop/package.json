{
  "name": "@atlas/desktop",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && ATLAS_UI_URL=http://localhost:5173 electron .",
    "app": "npm -w @atlas/ui run build && npm run build && electron .",
    "dist": "npm -w @atlas/ui run build && npm run build && electron-builder",
    "dist:mac": "npm -w @atlas/ui run build && npm run build && electron-builder --mac",
    "dist:win": "npm -w @atlas/ui run build && npm run build && electron-builder --win",
    "install:mac": "node install-mac.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  },
  "description": "Atlas: agents, kanban and canvas",
  "author": "Can Soylu",
  "version": "0.1.0",
  "dependencies": {
    "@atlas/engine": "*",
    "better-sqlite3": "^13.0.3"
  },
  "build": {
    "appId": "com.csoylu.atlas",
    "productName": "Atlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/ui/dist",
        "to": "ui"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
